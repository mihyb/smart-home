sitemap ruprechtice label="Ruprechtice" {
    Frame label="Pracovna" {
        Switch item=akvarium_svetlo_switch label="Akvarium světlo"
        Switch item=vysousec_switch label="Zásuvka okno"
        Switch item=Infrared_heating_panel_switch label="Topení"
        Text item=pracovna_teplota_humidity label="Vlhkost [%.0f %%]" labelcolor=[>60="red"]
        Text item=pracovna_teplota_temp label="Teplota [%.1f °C]" labelcolor=[<18="blue"]
    }
    Frame label="Pokojíček" {
        Text item=pokojicek_temp_humidity label="Vlhkost [%.0f %%]" labelcolor=[>60="red"]
        Text item=pokojicek_temp_temperature label="Teplota [%.1f °C]" labelcolor=[<18="blue"]
    }
    Frame label="Obyvák" {
        Switch item=obyvak_switch label="Stromeček"
        Text item=obyvak_temp_humidity label="Vlhkost [%.0f %%]" labelcolor=[>60="red"]
        Text item=obyvak_temp_temperature label="Teplota [%.1f °C]" labelcolor=[<18="blue"]
    }
    Frame label="Chodba" {
        Text item=chodba_temp_humidity label="Vlhkost [%.0f %%]" labelcolor=[>60="red"]
        Text item=chodba_temp_temperature label="Teplota [%.1f °C]" labelcolor=[<18="blue"]
    }
    Frame label="Koupelna" {
        Text item=koupelna_temp_humidity label="Vlhkost [%.0f %%]" labelcolor=[>60="red"]
        Text item=koupelna_temp_temperature label="Teplota [%.1f °C]" labelcolor=[<18="blue"]
    }
    Frame label="Zadveri" {
        Text item=zadveri_temp_humidity label="Vlhkost [%.0f %%]" labelcolor=[>60="red"]
        Text item=zadveri_temp_temperature label="Teplota [%.1f °C]" labelcolor=[<18="blue"]
    }
    Frame label="Kotelna" {
        Switch item=Kotelna_zasuvka label="Zásuvka"
    }
    Frame label="Sklep" {
        Text item=sklep_temp_humidity label="Vlhkost [%.0f %%]" labelcolor=[>60="red"]
        Text item=sklep_temp_temperature label="Teplota [%.1f °C]" labelcolor=[<18="blue"]
    }
    Frame label="Servis" {
        Text item=pracovna_teplota_battery label="Pracovna teploměr baterie [%.0f %%]" labelcolor=[<20="red"]
        Text item=pokojicek_temp_battery label="Pokojicek teploměr baterie [%.0f %%]" labelcolor=[<20="red"]
        Text item=chodba_temp_battery label="Chodba teploměr baterie [%.0f %%]" labelcolor=[<20="red"]
        Text item=zadveri_temp_battery label="Zadveří teploměr baterie [%.0f %%]" labelcolor=[<20="red"]
        Text item=koupelna_temp_battery label="Koupelna teploměr baterie [%.0f %%]" labelcolor=[<20="red"]
        Text item=obyvak_temp_battery label="Obyvák teploměr baterie [%.0f %%]" labelcolor=[<20="red"]
        Text item=sklep_temp_battery label="Obyvák teploměr baterie [%.0f %%]" labelcolor=[<20="red"]
    }
}