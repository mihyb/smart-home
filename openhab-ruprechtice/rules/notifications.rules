// Sends push notifications through the openHAB Cloud connector.
//
// This is the only file that calls the cloud actions. See items/notifications.items
// for the payload, and HomeController's app.alarmJobs for what decides to send.

var Timer backendTimer = null

rule "Push notification"
 when
     Item notify_message received command
 then
     // Java's split drops trailing empty fields, so a withdrawal ("CLEAR|id|")
     // arrives as two parts and the text is simply absent.
     val parts = receivedCommand.toString.split("\\|")
     if (parts.size < 2) {
         logWarn("notifications", "ignoring malformed payload: {}", receivedCommand.toString)
     } else {
         val severity = parts.get(0)
         val id = parts.get(1)
         val text = if (parts.size > 2) parts.get(2) else ""
         if (severity == "CLEAR") {
             hideBroadcastNotificationByReferenceId(id)
         } else {
             // message, icon, tag, title, referenceId, onClickAction,
             // mediaAttachmentUrl, actionButton1, actionButton2, actionButton3
             sendBroadcastNotification(text, null, severity, null, id, null, null, null, null, null)
         }
     }
 end

// The alarm table lives in HomeController, so it cannot report its own death:
// if that service stops, every alarm in it goes quiet and the house looks fine.
// This rule is the one thing that has to stay outside it.
//
// Five minutes of grace because deploy.sh restarts the service, and a restart
// is not an outage worth a push.
rule "HomeController is not answering"
 when
     Item backend_online changed
 then
     if (backend_online.state == OFF) {
         if (backendTimer === null) {
             backendTimer = createTimer(now.plusMinutes(5), [ |
                 if (backend_online.state == OFF) {
                     sendBroadcastNotification(
                         "HomeController neběží, hlídání ohradníku se neozve", null, "ALARM",
                         null, "backend-down", null, null, null, null, null
                     )
                 }
                 backendTimer = null
             ])
         }
     } else {
         if (backendTimer !== null) {
             backendTimer.cancel
             backendTimer = null
         }
         hideBroadcastNotificationByReferenceId("backend-down")
     }
 end
