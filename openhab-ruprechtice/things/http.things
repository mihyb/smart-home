// http Things — generated from JSONDB by scripts/jsondb-to-things.py
// Edit this file, not the UI: file-defined Things are read-only in the UI
// and are what makes this config reproducible on a new machine.

Thing http:url:backend_status "HTTP URL Thing" [
    authMode="BASIC",
    // HomeController runs on this same host now, so loopback: the check was
    // still pointed at .109 after the cutover and had been reading a dead
    // endpoint ever since.
    baseURL="http://127.0.0.1:8181/actuator",
    bufferSize=2048,
    commandMethod="GET",
    contentType="application/json",
    delay=0,
    ignoreSSLErrors=false,
    refresh=30,
    stateMethod="GET",
    timeout=3000
] {
    Channels:
        Type request-date-time : last-failure "Last Failure"
        Type request-date-time : last-success "Last Success"
        Type string : backend_status_health "backend health status" [ stateExtension="health", stateTransformation="JSONPATH($.status)", "" ]
}
