[Unit]
Description=HomeController OpenHAB rules engine
Documentation=https://github.com/mihyb/smart-home
After=network-online.target openhab.service
Wants=network-online.target

[Service]
Type=simple
User=ruprecht
Group=ruprecht
WorkingDirectory=/home/ruprecht/app

# openHAB runs on this same host now, so talk to it over loopback: no network
# round trip, and it keeps working if the machine's address ever changes.
Environment=OPENHAB_HOST=127.0.0.1
Environment=OPENHAB_PORT=8080
Environment=H2_DATA_PATH=/home/ruprecht/app/data/demo
EnvironmentFile=-/etc/default/homecontroller

ExecStart=/usr/bin/java -Xms64m -Xmx256m -XX:+ExitOnOutOfMemoryError \
    -jar /home/ruprecht/app/HomeController-0.0.1-SNAPSHOT.jar

Restart=always
RestartSec=15s
MemoryMax=1G
MemoryHigh=768M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=homecontroller

[Install]
WantedBy=multi-user.target
