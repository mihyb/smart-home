# IDE
.idea/
*.iml

# Claude Code — settings.json is shared, settings.local.json is per-machine
.claude/settings.local.json

# Logs pulled down from servers for troubleshooting
/logs/
*.log

# Real Tuya credentials — generate from things/tuya.things.example
openhab-ruprechtice/things/tuya.things

# Real ATMOS gateway credentials — generate from things/atmoswg1000.things.example
openhab-ruprechtice/things/atmoswg1000.things

# Real fencee Cloud account -- generate from things/fenceecloud.things.example.
# This one also carries the gateway's pairing id, and this repository is public.
openhab-ruprechtice/things/fenceecloud.things

# Python bytecode from the generator scripts
__pycache__/
*.pyc

# Cloud account passwords, kept next to the repo and read file-to-file by the
# scripts that need them (fencee Cloud, myopenhab.org) — never commit
*.pass
