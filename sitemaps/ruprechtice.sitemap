sitemap ruprechtice label="Ruprechtice" {
    Frame label="Pracovna" {
        Switch item=akvarium_svetlo_switch label="Akvarium světlo"
        Switch item=vysousec_switch label="Zásuvka okno"
        Text item=pracovna_teplota_humidity label="Vlhkost [%.0f %%]"
        Text item=pracovna_teplota_temp label="Teplota [%.1f °C]"
    }
    Frame label="Pokojíček" {
        Text item=pokojicek_temp_humidity label="Vlhkost [%.0f %%]"
        Text item=pokojicek_temp_temperature label="Teplota [%.1f °C]"
    }
    Frame label="Obyvák" {
        Switch item=obyvak_switch label="Stromeček"
        Text item=obyvak_temp_humidity label="Vlhkost [%.0f %%]"
        Text item=obyvak_temp_temperature label="Teplota [%.1f °C]"
    }
    Frame label="Chodba" {
        Text item=chodba_temp_humidity label="Vlhkost [%.0f %%]"
        Text item=chodba_temp_temperature label="Teplota [%.1f °C]"
    }
    Frame label="Koupelna" {
        Text item=koupelna_temp_humidity label="Vlhkost [%.0f %%]"
        Text item=koupelna_temp_temperature label="Teplota [%.1f °C]"
    }
    Frame label="Zadveri" {
        Text item=zadveri_temp_humidity label="Vlhkost [%.0f %%]"
        Text item=zadveri_temp_temperature label="Teplota [%.1f °C]"
    }
    Frame label="Kotelna" {
        Switch item=Kotelna_zasuvka label="Zásuvka"
    }

    Frame label="Servis" {
        Text item=pracovna_teplota_battery label="Pracovna teploměr baterie [%.0f %%]"
        Text item=pokojicek_temp_battery label="Pokojicek teploměr baterie [%.0f %%]"
        Text item=chodba_temp_battery label="Chodba teploměr baterie [%.0f %%]"
        Text item=zadveri_temp_battery label="Zadveří teploměr baterie [%.0f %%]"
        Text item=koupelna_temp_battery label="Koupelna teploměr baterie [%.0f %%]"
         Text item=obyvak_temp_battery label="Obyvák teploměr baterie [%.0f %%]"
    }
}