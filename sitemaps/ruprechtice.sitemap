sitemap ruprechtice label="Ruprechtice" {
    Frame label="Pracovna" {
        Switch item=vysousec_switch label="Zásuvka okno"
        Text item=pracovna_teplota_humidity label="Vlhkost [%.0f %%]" labelcolor=[>60="red"]
        Text item=pracovna_teplota_temp label="Teplota [%.1f °C]" labelcolor=[<18="blue"]
        Frame label="Rybicky světlo" {
            Switch item=timer_job_aquarium_status label="Časovač"
            Switch item=akvarium_svetlo_switch label="Stav"
            Setpoint item=timer_job_aquarium_from label="Od" minValue=0 maxValue=23 step=1
            Setpoint item=timer_job_aquarium_to label="Do" minValue=0 maxValue=23 step=1
        }
        Frame label="Topení" {
            Switch item=timer_job_wr_heating_status label="Časovač"
            Switch item=Infrared_heating_panel_switch label="Stav"
            Setpoint item=timer_job_wr_heating_from label="Od" minValue=0 maxValue=23 step=1
            Setpoint item=timer_job_wr_heating_to label="Do" minValue=0 maxValue=23 step=1
        }
    }
    Frame label="Chodba" {
            Text item=chodba_temp_humidity label="Vlhkost [%.0f %%]" labelcolor=[>60="red"]
            Text item=chodba_temp_temperature label="Teplota [%.1f °C]" labelcolor=[<18="blue"]
        }
    Frame label="Pokojíček" {
        Text item=pokojicek_temp_humidity label="Vlhkost [%.0f %%]" labelcolor=[>60="red"]
        Text item=pokojicek_temp_temperature label="Teplota [%.1f °C]" labelcolor=[<18="blue"]
        Frame label="Odvlhčovač" {
            Switch item=timer_job_kr_moisture_status label="Časovač"
            Switch item=pokoj_vysousec_switch label="Stav"
            Setpoint item=timer_job_kr_moisture_from label="Od" minValue=0 maxValue=23 step=1
            Setpoint item=timer_job_kr_moisture_to label="Do" minValue=0 maxValue=23 step=1
        }
    }
    Frame label="Obyvák" {
        Text item=obyvak_temp_humidity label="Vlhkost [%.0f %%]" labelcolor=[>60="red"]
        Text item=obyvak_temp_temperature label="Teplota [%.1f °C]" labelcolor=[<18="blue"]
        Frame label="Stromeček" {
            Switch item=timer_job_xmass_status label="Časovač"
            Switch item=obyvak_switch label="Stav"
            Setpoint item=timer_job_xmass_from label="Od" minValue=0 maxValue=23 step=1
            Setpoint item=timer_job_xmass_to label="Do" minValue=0 maxValue=23 step=1
        }
        Frame label="Seroušek" {
            Switch item=timer_job_agama_status label="Časovač"
            Switch item=agama_switch label="Stav"
            Setpoint item=timer_job_agama_from label="Od" minValue=0 maxValue=23 step=1
            Setpoint item=timer_job_agama_to label="Do" minValue=0 maxValue=23 step=1
        }
    }
    Frame label="Koupelna" {
        Text item=koupelna_temp_humidity label="Vlhkost [%.0f %%]" labelcolor=[>60="red"]
        Text item=koupelna_temp_temperature label="Teplota [%.1f °C]" labelcolor=[<18="blue"]
    }
    Frame label="Zadveri" {
        Text item=zadveri_temp_humidity label="Vlhkost [%.0f %%]" labelcolor=[>60="red"]
        Text item=zadveri_temp_temperature label="Teplota [%.1f °C]" labelcolor=[<18="blue"]
    }
    Frame label="Kotelna" {
        Text item=smoke_sensor_smoke label="Kouř poplach" labelcolor=[ON="red"]
    }
    Frame label="Sklep" {
        Text item=sklep_temp_humidity label="Vlhkost [%.0f %%]" labelcolor=[>60="red"]
        Text item=sklep_temp_temperature label="Teplota [%.1f °C]" labelcolor=[<18="blue"]
        Text item=sklep_water_water_leak label=Voda labelcolor=[ON="red"]
    }
    Frame label="Servis" {
        Text item=pracovna_teplota_battery label="Pracovna teploměr baterie [%.0f %%]" labelcolor=[<20="red"]
        Text item=pokojicek_temp_battery label="Pokojicek teploměr baterie [%.0f %%]" labelcolor=[<20="red"]
        Text item=chodba_temp_battery label="Chodba teploměr baterie [%.0f %%]" labelcolor=[<20="red"]
        Text item=zadveri_temp_battery label="Zadveří teploměr baterie [%.0f %%]" labelcolor=[<20="red"]
        Text item=koupelna_temp_battery label="Koupelna teploměr baterie [%.0f %%]" labelcolor=[<20="red"]
        Text item=obyvak_temp_battery label="Obyvák teploměr baterie [%.0f %%]" labelcolor=[<20="red"]
        Text item=sklep_temp_battery label="Sklep teploměr baterie [%.0f %%]" labelcolor=[<20="red"]
        Text item=sklep_water_battery label="Sklep voda baterie [%.0f %%]" labelcolor=[<20="red"]
        Text item=smoke_sensor_battery_low label="Kourovy sensor slaba baterie" labelcolor=[ON="red"]
    }
}