  rule "Chodba hum calibration"
   when
       Item chodba_temp_humidity received command or
       Item chodba_temp_humidity changed
   then
       if (chodba_temp_humidity.state instanceof Number) {
           val newValue = (chodba_temp_humidity.state as Number).doubleValue - 0.15
           chodba_temp_humidity_calibrated.postUpdate(newValue)
           chodba_temp_humidity_calibrated_percent.postUpdate(newValue*100)
       } else {
           logWarn("item_calibration.rules", "chodba_temp_humidity state is not a number!")
       }
   end
