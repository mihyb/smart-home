sitemap ruprechtice label="Ruprechtice" {
    // Venkovní teplota z kotle ATMOS — není specifická pro kotelnu a řídí se
    // podle ní řada rozhodnutí, proto je hned nahoře.
    Frame {
        Text item=Atmos_Outdoor label="Venku [%.1f °C]" icon="temperature"
             valuecolor=[<0="blue", <10="cyan", >25="orange"]
        // Zhoršený = některé sledované zařízení je offline. Skupina je AND, takže
        // stačí jeden výpadek. Detail říká který.
        Text item=system_health label="Stav systému [MAP(health.map):%s]" icon="network"
             valuecolor=[ON="green", OFF="red"] {
            Frame label="Zigbee zařízení" {
                Text item=vysousec_online       valuecolor=[ON="green", OFF="red"]
                Text item=pokoj_vysousec_online valuecolor=[ON="green", OFF="red"]
                Text item=agama_online          valuecolor=[ON="green", OFF="red"]
                Text item=akvarium_online       valuecolor=[ON="green", OFF="red"]
                Text item=obyvak_online         valuecolor=[ON="green", OFF="red"]
                Text item=loznice_vetrak_online valuecolor=[ON="green", OFF="red"]
                Text item=pokoj_okno_online     valuecolor=[ON="green", OFF="red"]
                Text item=pracovna_okno_online  valuecolor=[ON="green", OFF="red"]
            }
            Frame label="Čidla" {
                Text item=chodba_temp_online    valuecolor=[ON="green", OFF="red"]
                Text item=pokojicek_temp_online valuecolor=[ON="green", OFF="red"]
                Text item=pracovna_temp_online  valuecolor=[ON="green", OFF="red"]
                Text item=koupelna_temp_online  valuecolor=[ON="green", OFF="red"]
                Text item=obyvak_temp_online    valuecolor=[ON="green", OFF="red"]
                Text item=zadveri_temp_online   valuecolor=[ON="green", OFF="red"]
            }
            Frame label="Služby" {
                Text item=atmos_gw_online       valuecolor=[ON="green", OFF="red"]
                Text item=backend_online        valuecolor=[ON="green", OFF="red"]
            }
        }
    }
    Frame label="Pracovna" {
        Text item=pracovna_teplota_humidity label="Vlhkost [%.0f %%]" labelcolor=[>60="red"]
        Text item=pracovna_teplota_temp label="Teplota [%.1f °C]" labelcolor=[<18="blue"]
        Text item=pracovna_okno_OnOff_Switch label="Okno" icon="window-open" valuecolor=[ON="green", OFF="red"]
        Text item=akvarium_svetlo_switch label="Rybičky světlo [%s]" icon="light"
             valuecolor=[ON="green", OFF="gray"] {
            Frame label="Rybičky světlo" {
                Switch item=akvarium_svetlo_switch label="Stav"
                Switch item=timer_job_aquarium_status label="Časovač"
                Setpoint item=timer_job_aquarium_from label="Od" minValue=0 maxValue=23 step=1
                Setpoint item=timer_job_aquarium_to label="Do" minValue=0 maxValue=23 step=1
            }
        }
        Text item=Infrared_heating_panel_switch label="Topení [%s]" icon="heating"
             valuecolor=[ON="green", OFF="gray"] {
            Frame label="Topení" {
                Switch item=Infrared_heating_panel_switch label="Stav"
                Switch item=timer_job_wr_heating_status label="Časovač"
                Setpoint item=timer_job_wr_heating_from label="Od" minValue=0 maxValue=23 step=1
                Setpoint item=timer_job_wr_heating_to label="Do" minValue=0 maxValue=23 step=1
            }
            Frame label="Teplota" {
                // Čidlo uvnitř panelu, ne teplota místnosti — ta je nahoře
                // v rámu Pracovna. Panel reguluje podle tohoto čidla.
                Text item=Infrared_heating_panel_temp_current label="Čidlo topení [%d °C]" icon="temperature"
                Setpoint item=Infrared_heating_panel_temp_set label="Cílová teplota" minValue=5 maxValue=50 step=1
            }
            Frame label="Displej" {
                Switch item=Infrared_heating_panel_light_display label="Kontrolka"
            }
        }
        Text item=vysousec_switch label="Odvlhčovač [%s]" icon="humidity"
             valuecolor=[ON="green", OFF="gray"] {
            Frame label="Odvlhčovač" {
                Switch item=vysousec_switch label="Stav"
                Switch item=timer_job_wr_moisture_status label="Časovač"
                Setpoint item=timer_job_wr_moisture_from label="Od" minValue=0 maxValue=23 step=1
                Setpoint item=timer_job_wr_moisture_to label="Do" minValue=0 maxValue=23 step=1
            }
        }
    }
    Frame label="Chodba" {
            Text item=chodba_temp_humidity_calibrated_percent label="Vlhkost [%.0f %%]" labelcolor=[>60="red"]
            Text item=chodba_temp_temperature label="Teplota [%.1f °C]" labelcolor=[<10="blue"]
            Text item=chick_01_power label="Kuřátka [%s]" icon="heating"
                 valuecolor=[ON="green", OFF="gray"] {
                Frame label="Kuřátka" {
                    Switch item=chick_01_power label="Stav"
                    Switch item=chicks_01_Chick_01_switch label="Topení"
                    Setpoint item=chick_01_min_temp label="Od" minValue=15 maxValue=34 step=1
                    Setpoint item=chick_01_max_temp label="Do" minValue=16 maxValue=35 step=1
                }
                Frame label="Teplota" {
                    // Teplota v líhni, ne na chodbě — ta je o řádek výš
                    // v rámu Chodba a pletla se s touhle.
                    Text item=chicks_01_Chick_01_temp label="Teplota v líhni [%.1f °C]" icon="temperature"
                }
            }
        }
    Frame label="Pokojíček" {
        Text item=pokojicek_temp_humidity label="Vlhkost [%.0f %%]" labelcolor=[>60="red"]
        Text item=pokojicek_temp_temperature label="Teplota [%.1f °C]" labelcolor=[<18="blue"]
        Text item=pokoj_okno_pokoj_okno_switch label="Okno" icon="window" valuecolor=[ON="green", OFF="red"]
        Text item=pokoj_vysousec_switch label="Odvlhčovač [%s]" icon="humidity"
             valuecolor=[ON="green", OFF="gray"] {
            Frame label="Odvlhčovač" {
                Switch item=pokoj_vysousec_switch label="Stav"
                Switch item=timer_job_kr_moisture_status label="Časovač"
                Setpoint item=timer_job_kr_moisture_from label="Od" minValue=0 maxValue=23 step=1
                Setpoint item=timer_job_kr_moisture_to label="Do" minValue=0 maxValue=23 step=1
            }
        }
    }
    Frame label="Obyvák" {
        Text item=obyvak_temp_humidity label="Vlhkost [%.0f %%]" labelcolor=[>60="red"]
        Text item=obyvak_temp_temperature label="Teplota [%.1f °C]" labelcolor=[<18="blue"]
        Text item=obyvak_switch label="Stromeček [%s]" icon="light"
             valuecolor=[ON="green", OFF="gray"] {
            Frame label="Stromeček" {
                Switch item=obyvak_switch label="Stav"
                Switch item=timer_job_xmass_status label="Časovač"
                Setpoint item=timer_job_xmass_from label="Od" minValue=0 maxValue=23 step=1
                Setpoint item=timer_job_xmass_to label="Do" minValue=0 maxValue=23 step=1
            }
        }
        Text item=obyvak_topeni_switch label="Topení [%s]" icon="heating"
             valuecolor=[ON="green", OFF="gray"] {
            Frame label="Topení" {
                Switch item=obyvak_topeni_switch label="Stav"
                Switch item=timer_job_lr_heating_status label="Časovač"
                Setpoint item=timer_job_lr_heating_from label="Od" minValue=0 maxValue=23 step=1
                Setpoint item=timer_job_lr_heating_to label="Do" minValue=0 maxValue=23 step=1
            }
            Frame label="Teplota" {
                // Vlastní čidlo uvnitř topení, ne teplota místnosti — ta je
                // nahoře v rámu Obyvák. U panelových topidel je čidlo u zdi a
                // studené, takže ukazuje výrazně míň (16 vs 20,6 °C při
                // vypnutém topení). Není to chyba převodu, stejnou hodnotu
                // vrací i Tuya cloud; regulace ale jede podle tohoto čidla.
                Text item=obyvak_topeni_temp_current label="Čidlo topení [%d °C]" icon="temperature"
                Setpoint item=obyvak_topeni_temp_set label="Cílová teplota" minValue=5 maxValue=50 step=1
            }
            Frame label="Displej" {
                Switch item=obyvak_topeni_light_display label="Kontrolka"
            }
        }
        Text item=agama_switch label="Seroušek [%s]" icon="heating"
             valuecolor=[ON="green", OFF="gray"] {
            Frame label="Seroušek" {
                Switch item=agama_switch label="Stav"
                Switch item=timer_job_agama_status label="Časovač"
                Setpoint item=timer_job_agama_from label="Od" minValue=0 maxValue=23 step=1
                Setpoint item=timer_job_agama_to label="Do" minValue=0 maxValue=23 step=1
            }
        }
    }
    Frame label="Koupelna" {
        Text item=koupelna_temp_humidity label="Vlhkost [%.0f %%]" labelcolor=[>60="red"]
        Text item=koupelna_temp_temperature label="Teplota [%.1f °C]" labelcolor=[<18="blue"]
    }
    Frame label="Zadveri" {
        Text item=zadveri_temp_humidity label="Vlhkost [%.0f %%]" labelcolor=[>60="red"]
        Text item=zadveri_temp_temperature label="Teplota [%.1f °C]" labelcolor=[<18="blue"]
    }
    Frame label="Kotelna" {
        Text item=smoke_sensor_smoke label="Kouř poplach" labelcolor=[ON="red"]
        // Bojler: stav a teplota vody na hlavní stránce, zbytek o klik dál.
        // Switch nesmí mít vnořené widgety (openHAB by celý sitemap zahodil),
        // takže rozklikávací řádek je Text — a nese rovnou stav časovače.
        Text item=bojler_switch label="Bojler [%s]" icon="water"
             valuecolor=[ON="green", OFF="gray"] {
            Frame label="Bojler" {
                Switch item=bojler_switch label="Stav"
                Switch item=timer_job_wheater_status label="Časovač"
                Setpoint item=timer_job_wheater_from label="Od" minValue=0 maxValue=23 step=1
                Setpoint item=timer_job_wheater_to label="Do" minValue=0 maxValue=23 step=1
            }
            Frame label="Napájení" {
                // Rozlišuje "vypnuto časovačem" od "není proud z HDO"
                Text item=wheater_status label="HDO [MAP(hdo.map):%s]" icon="energy"
                     valuecolor=["online"="green", "offline"="red"]
            }
        }
        Text item=Atmos_Water_Tank label="Teplota vody [%.1f °C]" icon="temperature"
             valuecolor=[<30="blue", <40="orange", >=40="red"]
        // Kotel na tuhá paliva. Spaliny + voda dohromady říkají, v jaké je fázi:
        // spaliny rostou a voda je studená = zatápí se; obojí vysoké = topí;
        // spaliny klesají a voda drží = dohořívá.
        // Kotel a jeho dva okruhy. Topný okruh i teplá voda jsou okruhy tohohle
        // kotle, proto sedí tady a ne u elektrického bojleru výš — ten je úplně
        // jiný spotřebič, který s ATMOSem nemá nic společného.
        Text item=Atmos_Exhaust_Fan label="Kotel [%s]" icon="fire"
             valuecolor=[ON="green", OFF="gray"] {
            Frame label="Hoření" {
                // Spaliny + voda dohromady říkají fázi: spaliny rostou a voda je
                // studená = zatápí se; obojí vysoké = topí; spaliny klesají a
                // voda drží = dohořívá.
                Text item=Atmos_Exhaust_Fan label="Hoří" icon="fire"
                     valuecolor=[ON="red", OFF="gray"]
                Text item=Atmos_FlueGas label="Spaliny [%.0f °C]" icon="flow"
                     valuecolor=[<100="gray", >250="red"]
                Text item=Atmos_Boiler_Water label="Voda v kotli [%.1f °C]" icon="temperature"
                     valuecolor=[<60="blue", >85="red"]
            }
            Frame label="Data" {
                Switch item=Atmos_Refresh label="Obnovit" mappings=[ON="Načíst"]
                // Hodiny regulátoru říkají, jak čerstvá data jsou.
                Text item=Atmos_Clock label="Čas regulátoru [%1$tH:%1$tM]" icon="time"
            }
            Frame label="Automatika" {
                // Zapnuto = režim níž řídí HomeController podle toho, jestli kotel
                // hoří, a ruční přepnutí vezme zpátky do pěti minut.
                Switch item=boiler_auto_control label="Řídit podle kotle"
                // Jen režimy, které samy nevyprší — AWAY a VISIT končí v daný čas
                // a automatika by je pak posílala pořád dokola.
                Selection item=boiler_auto_running_heating label="Topení když hoří" icon="fire"
                          mappings=[AUTO="Auto", STANDBY="Standby", COMFORT="Komfort"]
                Selection item=boiler_auto_running_water label="Voda když hoří" icon="water"
                          mappings=[AUTO="Auto", STANDBY="Standby", COMFORT="Komfort"]
                Selection item=boiler_auto_idle_heating label="Topení když nehoří" icon="fire"
                          mappings=[AUTO="Auto", STANDBY="Standby", COMFORT="Komfort"]
                Selection item=boiler_auto_idle_water label="Voda když nehoří" icon="water"
                          mappings=[AUTO="Auto", STANDBY="Standby", COMFORT="Komfort"]
            }
            Frame label="Topný okruh" {
                Selection item=Atmos_C1_Mode label="Režim" mappings=[AUTO="Auto", STANDBY="Standby", COMFORT="Komfort", AWAY="Absence", VISIT="Návštěva"]
                Selection item=Atmos_C1_Mode_Duration label="Na jak dlouho" mappings=[30="30 min", 60="1 h", 90="1,5 h", 120="2 h", 150="2,5 h", 180="3 h", 210="3,5 h", 240="4 h", 300="5 h", 360="6 h", 480="8 h", 600="10 h", 720="12 h"]
                Text item=Atmos_C1_Deadline label="Končí [%1$tH:%1$tM]" icon="time"
                Text item=Atmos_C1_Permanent_Mode label="Potom [%s]"
            }
            Frame label="Teplá voda" {
                Selection item=Atmos_Water_Mode label="Režim" mappings=[AUTO="Auto", STANDBY="Standby", COMFORT="Komfort", AWAY="Absence", VISIT="Návštěva"]
                Selection item=Atmos_Water_Mode_Duration label="Na jak dlouho" mappings=[30="30 min", 60="1 h", 90="1,5 h", 120="2 h", 150="2,5 h", 180="3 h", 210="3,5 h", 240="4 h", 300="5 h", 360="6 h", 480="8 h", 600="10 h", 720="12 h"]
                Text item=Atmos_Water_Deadline label="Končí [%1$tH:%1$tM]" icon="time"
                Text item=Atmos_Water_Permanent_Mode label="Potom [%s]"
            }
        }
        Text item=Atmos_Buffer_Charge label="Akumulace [%d %%]" icon="batterylevel"
             valuecolor=[<30="gray", <50="orange", >=50="red"] {
            Frame label="Čidla po výšce nádrže" {
                Text item=Atmos_Buffer_Zones label="Nahřátá čidla [%d ze 4]" icon="heating"
                Text item=Atmos_Buffer_1 label="1 nahoře [%.1f °C]" valuecolor=[>=70="red", <40="blue"]
                Text item=Atmos_Buffer_2 label="2 [%.1f °C]"        valuecolor=[>=70="red", <40="blue"]
                Text item=Atmos_Buffer_3 label="3 [%.1f °C]"        valuecolor=[>=70="red", <40="blue"]
                Text item=Atmos_Buffer_4 label="4 dole [%.1f °C]"   valuecolor=[>=70="red", <40="blue"]
            }
            Frame label="Průběh nabíjení" {
                Chart item=atmos_buffer period=D refresh=300
            }
        }
    }
    Frame label="Loznice" {
            Text item=loznice_vetrak_switch label="Větrák [%s]" icon="fan"
                 valuecolor=[ON="green", OFF="gray"] {
                Frame label="Větrák" {
                    Switch item=loznice_vetrak_switch label="Stav"
                    Switch item=timer_job_bedroom_fan_status label="Časovač"
                    Setpoint item=timer_job_bedroom_fan_from label="Od" minValue=0 maxValue=23 step=1
                    Setpoint item=timer_job_bedroom_fan_to label="Do" minValue=0 maxValue=23 step=1
                }
            }
        }
    Frame label="Sklep" {
        Text item=sklep_temp_humidity label="Vlhkost [%.0f %%]" labelcolor=[>75="red"]
        Text item=sklep_temp_temperature label="Teplota [%.1f °C]" labelcolor=[<10="blue"]
        Text item=sklep_water_water_leak label=Voda labelcolor=[ON="red"]
    }
    // Electric fence on the pasture: two PDX70 energizers, one shared battery.
    // The front page carries only the fence voltage, because it already says
    // everything -- 0 kV is an energizer that is off, and a low reading is a
    // fence that will not hold an animal. Source state, faults, signal, battery
    // and the age of the reading are one click in.
    //
    // Thresholds are in kilovolts, the unit these items are displayed in --
    // openHAB reads a bare number in a condition in the display unit, not in
    // the volts the binding stores. Green from 9 kV, orange from 5, red below:
    // stricter than the energizer's own alarm point of 3 kV, which is the level
    // where it complains rather than the level worth keeping.
    //
    // Readings come from fencee Cloud rather than the LAN, so when the internet
    // is down the binding blanks these rather than leaving a live-looking
    // voltage standing. An empty row means the fence cannot be seen, not that
    // it is fine -- "Data z" inside says how old the reading is.
    Frame label="Ohradník" {
        Text item=fence_upper_voltage label="Horní [%.1f kV]" icon="energy"
             valuecolor=[<5="red", <9="orange", >=9="green"] {
            Frame label="Horní" {
                // RUNNING is the only value known to mean running; anything else
                // the energizer reports shows as UNKNOWN (<n>) rather than as an
                // OFF the capture cannot support.
                Text item=fence_upper_state label="Zdroj [%s]" icon="energy"
                     valuecolor=["RUNNING"="green", "UNDEF"="gray"]
                Text item=fence_upper_fault label="Porucha [%s]" valuecolor=[ON="red", OFF="green"]
                Text item=fence_upper_signal label="Signál z brány [%.0f %%]" icon="network"
                     valuecolor=[<30="red", <60="orange", >=60="green"]
                Text item=fence_upper_updated label="Data z [%1$td.%1$tm. %1$tH:%1$tM]" icon="time"
                // The same battery as on the front page, in volts: the
                // percentage there is derived from this and hides the
                // difference between a full battery and one being charged.
                Text item=fence_battery label="Napětí baterie [%.1f V]" icon="batterylevel"
                     valuecolor=[<11.9="red", <12.4="orange", >=12.4="green"]
                // Here to tell "the gateway is down" apart from "this one
                // energizer has not reported over RF".
                Text item=fence_gateway_online label="Brána [MAP(online.map):%s]" icon="network"
                     valuecolor=[ON="green", OFF="red"]
            }
        }
        Text item=fence_lower_voltage label="Spodní [%.1f kV]" icon="energy"
             valuecolor=[<5="red", <9="orange", >=9="green"] {
            Frame label="Spodní" {
                // RUNNING is the only value known to mean running; anything else
                // the energizer reports shows as UNKNOWN (<n>) rather than as an
                // OFF the capture cannot support.
                Text item=fence_lower_state label="Zdroj [%s]" icon="energy"
                     valuecolor=["RUNNING"="green", "UNDEF"="gray"]
                Text item=fence_lower_fault label="Porucha [%s]" valuecolor=[ON="red", OFF="green"]
                Text item=fence_lower_signal label="Signál z brány [%.0f %%]" icon="network"
                     valuecolor=[<30="red", <60="orange", >=60="green"]
                Text item=fence_lower_updated label="Data z [%1$td.%1$tm. %1$tH:%1$tM]" icon="time"
                // The same battery as on the front page, in volts: the
                // percentage there is derived from this and hides the
                // difference between a full battery and one being charged.
                Text item=fence_battery label="Napětí baterie [%.1f V]" icon="batterylevel"
                     valuecolor=[<11.9="red", <12.4="orange", >=12.4="green"]
                // Here to tell "the gateway is down" apart from "this one
                // energizer has not reported over RF".
                Text item=fence_gateway_online label="Brána [MAP(online.map):%s]" icon="network"
                     valuecolor=[ON="green", OFF="red"]
            }
        }
        // One battery feeds both energizers, so it is one row rather than two.
        // SCALE turns the volts into a state of charge; the thresholds below
        // still compare the item's own state, which is volts, not the percent
        // the label shows.
        Text item=fence_battery_soc label="Baterie [%.0f %%]" icon="batterylevel"
             valuecolor=[<30="red", <60="orange", >=60="green"]
    }
    Frame label="Admin" {
        Frame label="Statistiky" {
            Chart item=humidity_sensors label="Vlhkost" period=W refresh=300
            Chart item=temp_sensors label="Teplota" period=W refresh=300
        }
        Frame label="Servis" {
            // Vyměnit = některá baterie pod 5 %. Jednotlivé články jsou o klik dál,
            // aby Servis nebyl deset řádků procent. Kouřový senzor tu není:
            // hlásí jen battery_low a jeho integrace není spolehlivá.
            Text item=battery_status label="Baterie [%s]" icon="batterylevel"
                 valuecolor=["OK"="green", "Vyměnit"="red"] {
                // Prahy jsou v procentech i u položek Number:Dimensionless, které
                // uvnitř drží poměr (0,19): openHAB čte číslo v podmínce v jednotce
                // ze state description, a tu tady určuje formát "%.0f %%".
                Frame label="Jednotlivé baterie" {
                    Text item=pracovna_teplota_battery label="Pracovna teploměr baterie [%.0f %%]" valuecolor=[<5="red", <20="orange", >=20="green"]
                    Text item=pokojicek_temp_battery label="Pokojicek teploměr baterie [%.0f %%]" valuecolor=[<5="red", <20="orange", >=20="green"]
                    Text item=chodba_temp_battery label="Chodba teploměr baterie [%.0f %%]" valuecolor=[<5="red", <20="orange", >=20="green"]
                    Text item=zadveri_temp_battery label="Zadveří teploměr baterie [%.0f %%]" valuecolor=[<5="red", <20="orange", >=20="green"]
                    Text item=koupelna_temp_battery label="Koupelna teploměr baterie [%.0f %%]" valuecolor=[<5="red", <20="orange", >=20="green"]
                    Text item=obyvak_temp_battery label="Obyvák teploměr baterie [%.0f %%]" valuecolor=[<5="red", <20="orange", >=20="green"]
                    Text item=sklep_temp_battery label="Sklep teploměr baterie [%.0f %%]" valuecolor=[<5="red", <20="orange", >=20="green"]
                    Text item=sklep_water_battery label="Sklep voda baterie [%.0f %%]" valuecolor=[<5="red", <20="orange", >=20="green"]
                    Text item=pokoj_okno_pokoj_okno_battery label="Pokoj okno baterie [%.0f %%]" valuecolor=[<5="red", <20="orange", >=20="green"]
                    Text item=pracovna_okno_battery label="Pracovna okno baterie [%.0f %%]" valuecolor=[<5="red", <20="orange", >=20="green"]
                }
            }
        }
    }
}